# ===== YieldNest Deployment Keys =====
# Copy this file to .env and fill in your actual keys.
# WARNING: Never commit .env to version control.

# Deployer private key (account that pays for contract deployment gas)
DEPLOYER_PRIVATE_KEY=

# 3-of-5 Multi-sig signer addresses (platform governance)
# Generate with: cast wallet new
MULTISIG_1=
MULTISIG_2=
MULTISIG_3=
MULTISIG_4=
MULTISIG_5=

# Platform owner address
PLATFORM_OWNER=

# Allocation engine operator address
ALLOCATION_ENGINE=

# ===== RPC URLs =====
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ===== Etherscan API Keys (for contract verification) =====
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
